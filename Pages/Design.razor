@page "/design"
@using PortfolioNaiquen.Shared.Components
@inject PortfolioNaiquen.Services.LanguageService Lang
@implements IDisposable

<PageTitle>@Lang.T("navDesign") - Naiquen Iturralde</PageTitle>

<div class="portfolio-page">
    <section class="page-hero fade-in">
        <div class="hero-content">
            <h1 class="page-title">
                <span class="gradient-text">@Lang.T("designPageTitle")</span>
            </h1>
            <p class="page-intro">@Lang.T("designPageIntro")</p>
        </div>
    </section>

    <section class="projects-section fade-in">
        <div class="projects-grid">
            <article class="riderone-feature-card glass hover-lift">
                <div class="riderone-feature-card__media">
                    <img src="img/LogoRiderOne.png" alt="@Lang.T("riderOneTitle")" loading="lazy" />
                </div>
                <div class="riderone-feature-card__content">
                    <h2 class="riderone-feature-card__title">@Lang.T("riderOneTitle")</h2>
                    <p class="riderone-feature-card__subtitle">@Lang.T("riderOneSubtitle")</p>
                    <p class="riderone-feature-card__desc">@Lang.T("riderOneCardDesc")</p>
                    <div class="riderone-feature-card__tags">
                        <span class="tag">UX/UI</span>
                        <span class="tag">Diseño 3D</span>
                        <span class="tag">ESP32</span>
                        <span class="tag">Prototipado</span>
                        <span class="tag">Hardware</span>
                        <span class="tag">IoT</span>
                    </div>
                    <div class="riderone-feature-card__actions">
                        <a href="riderone" class="project-button">@Lang.T("riderOneBtnProject")</a>
                        <a href="riderone#videos"
                           class="project-button secondary-button">@Lang.T("riderOneBtnVideos")</a>
                    </div>
                </div>
            </article>

            <article class="riderone-feature-card glass hover-lift">
                <div class="riderone-feature-card__media aura-media">
                    <img class="aura-asset" src="img/AuraAsset.png" alt="@Lang.T("walletAuraTitle")" loading="lazy" />
                </div>
                <div class="riderone-feature-card__content">
                    <h2 class="riderone-feature-card__title">@Lang.T("walletAuraTitle")</h2>
                    <p class="riderone-feature-card__subtitle">@Lang.T("walletAuraSubtitle")</p>
                    <p class="riderone-feature-card__desc">@Lang.T("walletAuraCardDesc")</p>
                    <div class="riderone-feature-card__tags">
                        <span class="tag">UX/UI</span>
                        <span class="tag">Blazor</span>
                        <span class="tag">C#</span>
                        <span class="tag">.NET</span>
                        <span class="tag">BigQuery</span>
                        <span class="tag">SQL</span>
                        <span class="tag">Looker Studio</span>
                    </div>
                    <div class="riderone-feature-card__actions">
                        <a href="walletaura#proyecto" class="project-button">@Lang.T("walletAuraBtnProject")</a>
                        <a href="walletaura#video"
                           class="project-button secondary-button">@Lang.T("walletAuraBtnVideo")</a>
                    </div>
                </div>
            </article>
        </div>
    </section>

    <section class="page-cta fade-in">
        <div class="cta-content">
            <h2 class="cta-title">@Lang.T("designCtaTitle")</h2>
            <p class="cta-text">@Lang.T("designCtaText")</p>
            <MagicButton Label="@Lang.T("designCtaButton")" To="/databases" AdditionalClass="large" />
        </div>
    </section>

    <section class="page-navigation fade-in">
        <CrossNavigationFooter CurrentPage="design" />
    </section>
</div>

@code {
    protected override void OnInitialized()
    {
        Lang.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Lang.OnChange -= StateHasChanged;
    }
}
