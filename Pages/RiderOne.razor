@page "/riderone"
@using PortfolioNaiquen.Shared.Components
@inject PortfolioNaiquen.Services.LanguageService Lang
@implements IDisposable

<PageTitle>@Lang.T("riderOneTitle") - Naiquen Iturralde</PageTitle>

<div class="riderone-page">
    <!-- ===================== HERO ===================== -->
    <section class="riderone-hero fade-in">
        <div class="hero-content">
            @if (!string.IsNullOrEmpty(RiderOneLogo))
            {
                <div class="riderone-logo">
                    <img src="@RiderOneLogo" alt="@Lang.T("riderOneTitle")" />
                </div>
            }
            <h1 class="page-title">
                <span class="gradient-text">@Lang.T("riderOneTitle")</span>
            </h1>
            <p class="page-subtitle">@Lang.T("riderOneSubtitle")</p>
            <p class="page-intro">@Lang.T("riderOneIntro")</p>
            <div class="hero-actions">
                <a href="design" class="project-button back-design-button">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 12H5M12 19l-7-7 7-7" />
                    </svg>
                    @Lang.T("riderOneBackDesign")
                </a>
            </div>
        </div>
    </section>

    <!-- ===================== INFORME / CASE STUDY ===================== -->
    <!-- Documentación: informe completo vertical (18 páginas seguidas) -->
    <section class="riderone-section fade-in">
        <header class="report-header">
            <p class="report-eyebrow">Documentación</p>
            <h2 class="section-title">Informe del proyecto</h2>
            <p class="report-lead">Proceso de investigación, diseño, desarrollo y validación de Rider One.</p>
        </header>

        <div class="report-document">
            @for (var i = 0; i < ReportImages.Count; i++)
            {
                <img class="report-page" src="@ReportImages[i]" alt="Rider One — página @(i + 1) del informe"
                     loading="@(i == 0 ? "eager" : "lazy")" decoding="async" />
            }
        </div>
    </section>

    <!-- ===================== DEL CONCEPTO AL PROTOTIPO (EXPO) ===================== -->
    <section class="riderone-section fade-in">
        <h2 class="section-title">Del concepto al prototipo</h2>
        <p class="section-lead">Prototipo funcional y presentación del proyecto durante la exposición.</p>

        <figure class="expo-photo">
            <img src="img/Rider-One/equipo-expo.jpg"
                 alt="Equipo Rider One junto al prototipo de bicicleta durante la Expo" loading="lazy"
                 decoding="async" />
            <figcaption class="expo-photo__caption">Presentación de Rider One en la Expo — equipo y prototipo funcional.
            </figcaption>
        </figure>
    </section>

    <!-- ===================== EVOLUCIÓN ===================== -->
    <section class="riderone-section fade-in">
        <h2 class="section-title">@Lang.T("riderOneEvolutionTitle")</h2>

        <div class="timeline">
            <article class="timeline-block glass">
                <div class="timeline-year">2024</div>
                <div class="timeline-content">
                    <h3 class="timeline-title">@Lang.T("riderOneYear2024Title")</h3>
                    <ul class="timeline-list">
                        <li>@Lang.T("riderOneYear2024Item1")</li>
                        <li>@Lang.T("riderOneYear2024Item2")</li>
                        <li>@Lang.T("riderOneYear2024Item3")</li>
                        <li>@Lang.T("riderOneYear2024Item4")</li>
                        <li>@Lang.T("riderOneYear2024Item5")</li>
                        <li>@Lang.T("riderOneYear2024Item6")</li>
                    </ul>
                </div>
            </article>

            <article class="timeline-block glass">
                <div class="timeline-year">2025</div>
                <div class="timeline-content">
                    <h3 class="timeline-title">@Lang.T("riderOneYear2025Title")</h3>
                    <ul class="timeline-list">
                        <li>@Lang.T("riderOneYear2025Item1")</li>
                        <li>@Lang.T("riderOneYear2025Item2")</li>
                        <li>@Lang.T("riderOneYear2025Item3")</li>
                        <li>@Lang.T("riderOneYear2025Item4")</li>
                        <li>@Lang.T("riderOneYear2025Item5")</li>
                        <li>@Lang.T("riderOneYear2025Item6")</li>
                    </ul>
                </div>
            </article>
        </div>

        <div class="evolution-future glass">
            <h3 class="evolution-future__title">@Lang.T("riderOneFutureTitle")</h3>
            <p class="evolution-future__text">@Lang.T("riderOneFutureDesc")</p>
        </div>
    </section>

    <!-- ===================== ARQUITECTURA ===================== -->
    <section class="riderone-section fade-in">
        <h2 class="section-title">@Lang.T("riderOneArchTitle")</h2>
        <p class="section-lead">@Lang.T("riderOneArchIntro")</p>

        <div class="arch-grid">
            <div class="arch-card glass">
                <div class="arch-card__num">ESP32 #1</div>
                <h3 class="arch-card__title">@Lang.T("riderOneArchEsp1")</h3>
            </div>
            <div class="arch-card glass">
                <div class="arch-card__num">ESP32 #2</div>
                <h3 class="arch-card__title">@Lang.T("riderOneArchEsp2")</h3>
            </div>
            <div class="arch-card glass">
                <div class="arch-card__num">ESP32 #3</div>
                <h3 class="arch-card__title">@Lang.T("riderOneArchEsp3")</h3>
            </div>
        </div>

        <p class="riderone-card__text arch-note">@Lang.T("riderOneArchNote")</p>
    </section>

    <!-- ===================== PROTOTIPO EN ACCIÓN (VIDEOS) ===================== -->
    <section id="videos" class="riderone-section fade-in">
        <h2 class="section-title">Prototipo en acción</h2>
        <p class="section-lead">Videos del diseño 3D y del prototipo funcionando durante su presentación.</p>

        <div class="videos-grid">
            <article class="video-card glass">
                <video class="video-card__media" controls preload="metadata" playsinline>
                    <source src="img/videosRO/Prototipo3DBike.mp4" type="video/mp4" />
                    Tu navegador no soporta la reproducción de video HTML5.
                </video>
                <div class="video-card__body">
                    <h3 class="video-card__title">Diseño 3D y simulación</h3>
                    <p class="video-card__desc">Visualización del prototipo sobre la bicicleta y simulación del sistema
                        durante la etapa de desarrollo.</p>
                    </div>
                </article>

                <article class="video-card glass">
                    <video class="video-card__media" controls preload="metadata" playsinline>
                        <source src="img/videosRO/ExpoITES2025RO.mp4" type="video/mp4" />
                        Tu navegador no soporta la reproducción de video HTML5.
                    </video>
                    <div class="video-card__body">
                        <h3 class="video-card__title">Prototipo funcionando en la Expo</h3>
                        <p class="video-card__desc">Demostración del prototipo funcional de Rider One durante su
                            presentación.</p>
                        </div>
                    </article>
                </div>
            </section>

            <!-- ===================== RESULTADO ===================== -->
            <section class="riderone-section fade-in">
                <h2 class="section-title">Resultado</h2>
                <p class="report-lead">Rider One integró investigación UX/UI, diseño 3D, electrónica y desarrollo de prototipos
                    en una solución funcional orientada a mejorar la seguridad del ciclista.</p>

                    <div class="result-grid">
                        <article class="result-card glass">
                            <h3 class="result-card__title">DISEÑO UX/UI</h3>
                            <p class="result-card__text">Investigación y definición de la experiencia.</p>
                        </article>
                        <article class="result-card glass">
                            <h3 class="result-card__title">PROTOTIPADO</h3>
                            <p class="result-card__text">Diseño físico, modelado 3D y simulación.</p>
                        </article>
                        <article class="result-card glass">
                            <h3 class="result-card__title">VALIDACIÓN</h3>
                            <p class="result-card__text">Prototipo funcional presentado en exposición.</p>
                        </article>
                    </div>
                </section>

                <!-- ===================== EQUIPO ===================== -->
                <section class="riderone-section fade-in">
                    <h2 class="section-title">@Lang.T("riderOneTeamTitle")</h2>

                    <div class="team-grid">
                        <article class="team-card glass">
                            <h3 class="team-card__name">Naiquen Iturralde</h3>
                            <p class="team-card__role">@Lang.T("riderOneTeamNaiquenRole")</p>
                            <p class="team-card__desc">@Lang.T("riderOneTeamNaiquenDesc")</p>
                        </article>
                        <article class="team-card glass">
                            <h3 class="team-card__name">Mateo Lemes</h3>
                            <p class="team-card__role">@Lang.T("riderOneTeamMateoRole")</p>
                            <p class="team-card__desc">@Lang.T("riderOneTeamMateoDesc")</p>
                        </article>
                        <article class="team-card glass">
                            <h3 class="team-card__name">Nadia Lucero</h3>
                            <p class="team-card__role">@Lang.T("riderOneTeamNadiaRole")</p>
                            <p class="team-card__desc">@Lang.T("riderOneTeamNadiaDesc")</p>
                        </article>
                    </div>
                </section>

                <!-- ===================== PROPIEDAD INTELECTUAL ===================== -->
                <section class="riderone-section fade-in">
                    <div class="ip-note glass">
                        <h2 class="ip-note__title">@Lang.T("riderOneIpTitle")</h2>
                        <p class="ip-note__text">@Lang.T("riderOneIpText1")</p>
                        <p class="ip-note__text">@Lang.T("riderOneIpText2")</p>
                    </div>
                </section>

                <section class="page-navigation fade-in">
                    <CrossNavigationFooter CurrentPage="design" />
                </section>
            </div>

@code {
    private const string RiderOneLogo = "img/LogoRiderOne.png";

    // Informe exportado como imágenes PNG (carpeta wwwroot/img/Rider-One)
    private IReadOnlyList<string> ReportImages { get; } =
    [
        "img/Rider-One/1_R_O.png",
        "img/Rider-One/2_R_O.png",
        "img/Rider-One/3_R_O.png",
        "img/Rider-One/4_R_O.png",
        "img/Rider-One/5_R_O.png",
        "img/Rider-One/6_R_O.png",
        "img/Rider-One/7_R_O.png",
        "img/Rider-One/8_R_O.png",
        "img/Rider-One/9_R_O.png",
        "img/Rider-One/10_R_O.png",
        "img/Rider-One/11_R_O.png",
        "img/Rider-One/12_R_O.png",
        "img/Rider-One/13_R_O.png",
        "img/Rider-One/14_R_O.png",
        "img/Rider-One/15_R_O.png",
        "img/Rider-One/16_R_O.png",
        "img/Rider-One/17_R_O.png",
        "img/Rider-One/18_R_O.png",
    ];

    protected override void OnInitialized()
    {
        Lang.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Lang.OnChange -= StateHasChanged;
    }
}
