@page "/about"
@using PortfolioNaiquen.Shared.Components
@using PortfolioNaiquen.Shared
@inject PortfolioNaiquen.Services.LanguageService Lang
@implements IDisposable

<PageTitle>@Lang.T("aboutTitle") - Naiquen Iturralde</PageTitle>

<div class="about-page">
    <div class="about-hero fade-in">
        <h1 class="about-title">
            <span class="gradient-text">@Lang.T("aboutTitle")</span>
        </h1>

        <div class="about-card glass">
            <p class="about-text">
                @Lang.T("aboutP1")
                <br /><br />

                @Lang.T("aboutP2")
                <br /><br />

                @Lang.T("aboutP3")
                <br /><br />

                @Lang.T("aboutP4")
                <br /><br />

                @Lang.T("aboutP5")
            </p>
        </div>
    </div>

    <div class="about-photo">
        <ImageFullscreen ImageSrc="@ProfileImage.Url" Alt="@ProfileImage.Alt" />
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        Lang.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Lang.OnChange -= StateHasChanged;
    }
}
